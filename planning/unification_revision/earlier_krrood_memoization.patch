+@dataclass
+class ProcedureResults:
+    """
+    The value of each distinct predicate or symbolic-function call made during one
+    evaluation, and the truth of each predicate instance read as a condition.
+
+    A query reads a predicate as one relation during its evaluation, so a procedure is
+    called once per distinct tuple of argument objects (compared by identity) and its
+    result is reused. This assumes that a procedure's result does not change while one
+    query is evaluated. An iterator result is not reused, since its reader consumes it.
+    """
+
+    values: Dict[Tuple, Tuple[Dict[str, Any], Any]] = field(default_factory=dict)
+    """
+    The arguments and the value, per procedure and argument identities.
+    """
+
+    truths: Dict[int, Tuple[Any, bool]] = field(default_factory=dict)
+    """
+    The predicate instance and its truth, per identity of the instance.
+    """
+
+    def value_of(
+        self, procedure: Callable, arguments: Dict[str, Any], compute: Callable[[], Any]
+    ) -> Any:
+        key = (id(procedure),) + tuple(
+            sorted((name, id(value)) for name, value in arguments.items())
+        )
+        if key in self.values:
+            return self.values[key][1]
+        value = compute()
+        if not isinstance(value, Iterator):
+            self.values[key] = (arguments, value)
+        return value
+
+    def truth_of(self, instance: Any, compute: Callable[[], bool]) -> bool:
+        if id(instance) not in self.truths:
+            self.truths[id(instance)] = (instance, compute())
+        return self.truths[id(instance)][1]
+
+
+_procedure_results: ContextVar[Optional[ProcedureResults]] = ContextVar(
+    "procedure_results", default=None
+)
+"""
+The procedure results of the query evaluation in progress, if any.
+"""
